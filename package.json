{
  "name": "sso-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Launcher ringan untuk SSO UNESA",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "build": "npm run build:client && npm run build:spa",
    "build:client": "esbuild src/app.js --bundle --format=iife --target=es2020 --minify --outfile=public/app.js",
    "build:spa": "vite build",
    "dev:spa": "vite --host 127.0.0.1 --port 4174",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "motion": "^14.10.1",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "vite": "^8.3.7"
  }
}
