{
  "name": "sso-lite",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Launcher ringan untuk SSO UNESA",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "build": "npm run build:images && npm run build:client && npm run build:spa",
    "build:images": "node scripts/build-images.js",
    "build:client": "esbuild src/app.js --bundle --format=iife --target=es2020 --minify --outfile=public/app.js",
    "build:spa": "node scripts/clean-spa.js && vite build",
    "dev:spa": "vite --host 127.0.0.1 --port 4174",
    "test:search": "node --test app/src/lib/search.test.mjs",
    "test:qa": "node tests/qa.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:preview": "npm run build && npx wrangler deploy --config wrangler.preview.toml"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@dnd-kit-svelte/core": "^0.0.11",
    "@dnd-kit-svelte/sortable": "^0.0.11",
    "bits-ui": "^1.8.0",
    "motion": "^14.10.1",
    "playwright-core": "^1.65.0",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "vite": "^8.3.7"
  }
}
